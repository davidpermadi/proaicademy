# Supabase Edge Function secrets (SERVER-SIDE — keep secret, never commit the real file).
# Copy to ./supabase/functions/.env and push to your project with:
#     supabase secrets set --env-file ./supabase/functions/.env
#
# Note: SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY and SUPABASE_ANON_KEY are injected
# into Edge Functions automatically by Supabase — do NOT set them here.

# Midtrans SERVER key (secret). Production: Mid-server-xxxx ; sandbox usually SB-Mid-server-xxxx
# (this account's sandbox keys lack the SB- prefix, so never infer the environment from it).
MIDTRANS_SERVER_KEY=

# true = Midtrans PRODUCTION (live payments), false = sandbox. This project runs in
# production — keep in sync with the frontend MIDTRANS_IS_PRODUCTION value.
MIDTRANS_IS_PRODUCTION=true

# Optional. Where Midtrans posts payment notifications. Leave empty to use this project's
# own midtrans-webhook (derived from SUPABASE_URL). Sent per transaction via the
# X-Override-Notification header, so the dashboard's notification field is not needed.
# MIDTRANS_NOTIFICATION_URL=

# Resend API key — sends the "you have a sale" e-mail when a payment succeeds.
# Without it payments still process normally; only the notification is skipped, and the
# order is left with owner_notified_at = null so it is findable.
RESEND_API_KEY=

# Optional overrides for that e-mail. The FROM domain must be verified in Resend.
# SALE_NOTIFY_TO=davidpermadi@proaicademy.id
# SALE_NOTIFY_FROM=ProAIcademy <sales@proaicademy.id>
